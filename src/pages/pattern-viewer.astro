---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Open a layered PDF sewing pattern, switch off the sizes you are not cutting, and print yours at true 1:1 scale. No Acrobat, nothing uploaded.';

// One source for the visible Q&A and the FAQPage structured data, so the two
// cannot drift apart — Google drops FAQ markup that has no on-page counterpart.
// Most of this was already written as helper text inside the print dialog and
// the empty states, where it only appears mid-task.
const faqs = [
  {
    q: 'Do I need Adobe Acrobat to print one size?',
    a: 'No. Layer switches are a standard PDF feature, but most readers — including the one built into your browser and the Preview app on a Mac — do not expose them, which is why the usual advice is to install Acrobat. This page reads the same layer information and shows you the switches directly.',
  },
  {
    q: 'Is my pattern uploaded anywhere?',
    a: 'No. The PDF is read off your disk by your own browser, and there is no server behind this page to send it to. Nothing is uploaded and nothing is stored.',
  },
  {
    q: 'My test square printed blank. What went wrong?',
    a: 'The pattern keeps its test square on a layer you have switched off. Turn a shared layer such as “All Sizes” back on and print the square again — those layers usually hold the square, the notches, and the grainlines as well as the outlines.',
  },
  {
    q: 'The PDF has no layers in it. Can I still use this?',
    a: 'Yes, though there will be nothing to switch on or off. A pattern with no layers is usually a single-size pattern, or one whose sizes were flattened before it was saved. You can still view it and print it at true 1:1 scale from here.',
  },
  {
    q: 'Why does it matter that I print at Actual Size?',
    a: 'A PDF carries its own page size, so a printer set to “Fit to page” will quietly shrink it by a few percent to clear its own unprintable margin, and every seam allowance shrinks with it. Printing at Actual Size, or 100%, is what keeps the pattern true. Print the test square first and measure it with a ruler before committing paper to the rest.',
  },
  {
    q: 'Which layers should I leave switched on?',
    a: 'Turn off the sizes you are not cutting — they are usually named something like “Size 12” or grouped by paper size such as “A4 / Letter”. Leave on anything holding the outlines, notches, grainlines, or a shared “All Sizes” layer, or you will print a page with pieces missing.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'PDF Pattern Layer Viewer',
      url: 'https://nedworkshop.org/pattern-viewer',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (web browser)',
      browserRequirements: 'Requires JavaScript.',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://nedworkshop.org/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title="Print One Size From a Layered PDF Pattern"
  description={description}
  image="/images/og/pattern-viewer.jpg"
  jsonLd={jsonLd}
>
  <!-- Page header -->
  <section class="bg-amber-50 py-10 border-b-2 border-amber-200">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-xs font-extrabold uppercase tracking-wider text-stone-500">PDF Pattern Layer Viewer</p>
      <h1 class="mt-2 text-4xl md:text-6xl font-extrabold text-amber-700">
        Print One Size From a Layered PDF Pattern
      </h1>
      <p class="mt-4 text-lg md:text-2xl text-stone-700 font-semibold">
        Pick your size. Print it at 1:1. No Acrobat needed.
      </p>
      <p class="mt-3 text-sm md:text-base text-stone-600 font-medium max-w-2xl mx-auto">
        Layered PDF patterns let you hide the sizes you are not cutting &mdash; but most PDF readers
        will not show you the switches. This one does, right here in your browser.
        <strong class="text-stone-700">Your pattern never leaves your device.</strong>
      </p>
    </div>
  </section>

  <!-- No-JS fallback -->
  <noscript>
    <div class="max-w-3xl mx-auto px-6 py-10">
      <p class="bg-white border-2 border-amber-300 rounded-2xl p-5 text-stone-700 font-semibold">
        This tool needs JavaScript to open and draw your PDF. Everything runs on your own computer
        &mdash; nothing is uploaded &mdash; but that does mean the page cannot work with scripting
        turned off.
      </p>
    </div>
  </noscript>

  <!-- Step 1: choose a file -->
  <section id="pv-intro" class="py-12 bg-amber-100">
    <div class="max-w-3xl mx-auto px-6">
      <label
        id="pv-dropzone"
        for="pv-file"
        class="block bg-white/80 border-4 border-dashed border-amber-300 rounded-3xl p-10 text-center cursor-pointer transition-colors hover:border-amber-500 hover:bg-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-amber-500" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <path d="M14 2v6h6"></path>
          <path d="M12 18v-6"></path>
          <path d="m9 15 3-3 3 3"></path>
        </svg>
        <p class="mt-4 text-2xl font-extrabold text-amber-700">Choose a PDF pattern</p>
        <p class="mt-1 text-stone-600 font-semibold">or drag and drop it here</p>
        <input id="pv-file" type="file" accept="application/pdf,.pdf" class="sr-only" />
      </label>

      <p id="pv-intro-status" class="mt-4 text-center font-bold text-amber-700 min-h-[1.5rem]" role="status" aria-live="polite"></p>

      <div class="mt-10 grid sm:grid-cols-3 gap-5 text-center">
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#128274;</p>
          <h3 class="mt-2 font-extrabold text-amber-700">Stays on your device</h3>
          <p class="mt-1 text-sm text-stone-600 font-medium">The PDF is read in your browser. There is no upload and no server.</p>
        </div>
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#129525;</p>
          <h3 class="mt-2 font-extrabold text-amber-700">Hide the other sizes</h3>
          <p class="mt-1 text-sm text-stone-600 font-medium">Flip off every layer you are not cutting so the lines you trace are the only ones on the page.</p>
        </div>
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#128207;</p>
          <h3 class="mt-2 font-extrabold text-amber-700">Prints at true size</h3>
          <p class="mt-1 text-sm text-stone-600 font-medium">Pages print at their exact PDF dimensions, and you can print the test square first to prove it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2: the viewer -->
  <section id="pv-viewer" class="bg-amber-100 pb-6" hidden>
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Toolbar. The band carries the section background and the full container
           width so pages scroll cleanly underneath rather than peeking out. -->
      <div id="pv-toolbar" class="sticky z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 pt-4 pb-3 lg:pt-6 lg:pb-4 bg-amber-100">
      <div class="bg-white border-2 border-amber-200 rounded-2xl px-3 py-2 lg:px-4 lg:py-3 shadow-sm flex flex-wrap items-center gap-x-4 gap-y-2 lg:gap-y-3">
        <div class="min-w-0 flex-1">
          <p id="pv-filename" class="font-extrabold text-amber-700 truncate"></p>
          <p id="pv-pagecount" class="hidden sm:block text-sm text-stone-500 font-semibold"></p>
        </div>

        <div class="flex items-center gap-1 bg-amber-50 border border-amber-200 rounded-full p-1">
          <button id="pv-zoom-out" type="button" aria-label="Zoom out" class="w-9 h-9 rounded-full font-extrabold text-amber-700 hover:bg-amber-200 transition-colors">&minus;</button>
          <span id="pv-zoom-level" class="w-16 text-center text-sm font-extrabold text-stone-600 tabular-nums">100%</span>
          <button id="pv-zoom-in" type="button" aria-label="Zoom in" class="w-9 h-9 rounded-full font-extrabold text-amber-700 hover:bg-amber-200 transition-colors">+</button>
          <button id="pv-zoom-fit" type="button" class="px-3 h-9 rounded-full text-sm font-extrabold text-amber-700 hover:bg-amber-200 transition-colors">Fit</button>
        </div>

        <button id="pv-print" type="button" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-extrabold uppercase tracking-wider text-sm px-5 py-2.5 rounded-full shadow-md transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9V2h12v7"></path>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <path d="M6 14h12v8H6z"></path>
          </svg>
          Print
        </button>

        <button id="pv-close" type="button" class="text-sm font-extrabold text-stone-500 hover:text-amber-700 underline underline-offset-4 transition-colors">
          Open a different PDF
        </button>
      </div>
      </div>

      <div class="grid lg:grid-cols-[320px_minmax(0,1fr)] gap-4 items-start">
        <!-- Layer panel -->
        <aside id="pv-layers-panel" class="bg-white border-2 border-amber-200 rounded-2xl z-20">
          <div class="px-4 py-3 border-b-2 border-amber-200 flex items-center justify-between gap-2">
            <h2 class="text-lg font-extrabold text-amber-700">Layers</h2>
            <button id="pv-layers-toggle" type="button" class="lg:hidden text-sm font-extrabold text-amber-700" aria-expanded="true" aria-controls="pv-layers-body">Hide</button>
          </div>

          <div id="pv-layers-body">
            <div id="pv-layer-actions" class="px-4 py-3 flex flex-wrap gap-2 border-b border-amber-100" hidden>
              <button id="pv-show-all" type="button" class="px-3 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wide bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-200 transition-colors">Show all</button>
              <button id="pv-hide-all" type="button" class="px-3 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wide bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-200 transition-colors">Hide all</button>
              <button id="pv-reset-layers" type="button" class="px-3 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wide bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-200 transition-colors">Reset</button>
            </div>

            <div id="pv-layer-list" class="px-2 py-2 max-h-[60vh] overflow-y-auto"></div>

            <p id="pv-no-layers" class="px-4 py-4 text-sm text-stone-600 font-medium" hidden>
              This PDF has no layers in it, so there is nothing to switch on or off. That usually
              means it is a single-size pattern, or the sizes were flattened before it was saved.
              You can still view and print it at 1:1 from here.
            </p>
          </div>
        </aside>

        <!-- Pages -->
        <div id="pv-pages" class="min-w-0"></div>
      </div>
    </div>
  </section>

  <!-- Print dialog -->
  <dialog id="pv-print-dialog" class="rounded-2xl border-2 border-amber-300 p-0 w-[min(32rem,calc(100vw-2rem))] backdrop:bg-stone-900/40">
    <form method="dialog" id="pv-print-form" class="bg-white">
      <div class="px-6 py-4 border-b-2 border-amber-200">
        <h2 class="text-2xl font-extrabold text-amber-700">Print pattern</h2>
        <p class="text-sm text-stone-600 font-semibold mt-1">Hidden layers are left out of the printout.</p>
      </div>

      <div id="pv-print-options" class="px-6 py-5 space-y-5">
        <fieldset>
          <legend class="font-extrabold text-stone-700 mb-2">What to print</legend>

          <label class="flex items-start gap-3 py-1.5 cursor-pointer">
            <input type="radio" name="pv-scope" value="test" class="mt-1 accent-amber-500 w-4 h-4" checked />
            <span class="min-w-0">
              <span class="font-bold text-stone-700">Just the test square, on page</span>
              <input id="pv-test-page" type="number" min="1" value="1" class="w-16 ml-1 px-2 py-0.5 border-2 border-amber-200 rounded-lg font-bold text-stone-700 tabular-nums" aria-label="Page containing the test square" />
              <span class="block text-xs text-stone-500 font-medium mt-1">
                Print this one page first and measure the square with a ruler. If it measures right,
                the rest of the pattern will too. If the square comes out blank, the pattern keeps it
                on a shared layer &mdash; switch something like &ldquo;All Sizes&rdquo; back on.
              </span>
            </span>
          </label>

          <label class="flex items-start gap-3 py-1.5 cursor-pointer">
            <input type="radio" name="pv-scope" value="all" class="mt-1 accent-amber-500 w-4 h-4" />
            <span class="font-bold text-stone-700">
              The whole pattern
              <span id="pv-all-count" class="text-stone-500 font-semibold"></span>
            </span>
          </label>

          <label class="flex items-start gap-3 py-1.5 cursor-pointer">
            <input type="radio" name="pv-scope" value="range" class="mt-1 accent-amber-500 w-4 h-4" />
            <span class="min-w-0">
              <span class="font-bold text-stone-700">Pages</span>
              <input id="pv-range" type="text" placeholder="e.g. 1, 4-9" class="w-40 ml-1 px-2 py-0.5 border-2 border-amber-200 rounded-lg font-bold text-stone-700" aria-label="Page range to print" />
            </span>
          </label>
        </fieldset>

        <div>
          <label for="pv-paper" class="block font-extrabold text-stone-700 mb-1">Paper you are printing on</label>
          <select id="pv-paper" class="w-full px-3 py-2 border-2 border-amber-200 rounded-lg font-bold text-stone-700 bg-white">
            <option value="letter" selected>US Letter &mdash; 8.5 &times; 11 in</option>
            <option value="a4">A4 &mdash; 210 &times; 297 mm</option>
            <option value="legal">US Legal &mdash; 8.5 &times; 14 in</option>
            <option value="tabloid">Tabloid &mdash; 11 &times; 17 in</option>
            <option value="a3">A3 &mdash; 297 &times; 420 mm</option>
          </select>
          <p class="mt-1 text-xs text-stone-500 font-medium">
            Match this to the paper in the tray. The pattern is placed at its true size inside that
            sheet, so this never rescales it &mdash; it just stops the page spilling onto a second sheet.
          </p>
        </div>

        <div>
          <label for="pv-dpi" class="block font-extrabold text-stone-700 mb-1">Print quality</label>
          <select id="pv-dpi" class="w-full px-3 py-2 border-2 border-amber-200 rounded-lg font-bold text-stone-700 bg-white">
            <option value="150" selected>150 DPI &mdash; fast, fine for most patterns</option>
            <option value="300">300 DPI &mdash; sharper, slower and heavier</option>
          </select>
        </div>

        <p id="pv-page-size-note" class="text-sm text-stone-600 font-semibold"></p>

        <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-4">
          <p class="font-extrabold text-amber-700">When you print the PDF:</p>
          <ul class="mt-2 text-sm text-stone-700 font-semibold space-y-1 list-disc list-inside">
            <li>Scale &mdash; Safari calls it Scaling &mdash; at <strong>100%</strong>, or
              <strong>Actual Size</strong>. Never &ldquo;Fit to page&rdquo;.</li>
            <li>Paper size set to the same sheet you picked above</li>
          </ul>
          <p class="mt-2 text-xs text-stone-500 font-medium">
            You get a PDF rather than a direct printout on purpose. A web page gets re-laid-out by
            whichever browser prints it &mdash; Safari in particular ignores the margins a page asks
            for and pushes every sheet onto a second, mostly blank one. A PDF carries its own page
            size, so nothing can rescale it behind your back.
          </p>
        </div>

        <p id="pv-print-error" class="text-sm font-bold text-amber-800" role="alert" hidden></p>
      </div>

      <div id="pv-print-progress" class="px-6 py-8 text-center" hidden>
        <p id="pv-print-progress-text" class="font-extrabold text-amber-700" role="status" aria-live="polite">Preparing pages&hellip;</p>
        <div class="mt-3 h-2 bg-amber-100 rounded-full overflow-hidden">
          <div id="pv-print-bar" class="h-full bg-amber-500 transition-[width] duration-200" style="width:0%"></div>
        </div>
      </div>

      <div id="pv-print-ready" class="px-6 py-8 text-center" hidden>
        <p class="text-xl font-extrabold text-amber-700">Your PDF is ready</p>
        <p id="pv-print-ready-detail" class="mt-1 text-sm text-stone-600 font-semibold"></p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
          <a
            id="pv-open-link"
            href="#"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-extrabold uppercase tracking-wider text-sm px-6 py-3 rounded-full shadow-md transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9V2h12v7"></path>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <path d="M6 14h12v8H6z"></path>
            </svg>
            Open and print
          </a>
          <a
            id="pv-download-link"
            download
            href="#"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-extrabold text-amber-700 border-2 border-amber-300 hover:bg-amber-50 transition-colors text-sm"
          >
            Save to disk
          </a>
        </div>
        <p class="mt-4 text-xs text-stone-500 font-medium max-w-sm mx-auto">
          &ldquo;Open and print&rdquo; loads the PDF in a new tab. Press
          <strong>&#8984;P</strong> there and print at <strong>Actual Size</strong> &mdash; a PDF keeps
          its own page size, so the browser cannot re-lay-it-out the way it does a web page.
        </p>
      </div>

      <div class="px-6 py-4 border-t-2 border-amber-200 flex flex-wrap items-center justify-end gap-3">
        <button id="pv-print-cancel" type="button" class="px-4 py-2.5 rounded-full font-extrabold text-stone-600 hover:bg-stone-100 transition-colors">Cancel</button>
        <button id="pv-save-pdf" type="button" class="bg-amber-500 hover:bg-amber-600 text-white font-extrabold uppercase tracking-wider text-sm px-5 py-2.5 rounded-full shadow-md transition-colors">Make print-ready PDF</button>
      </div>
    </form>
  </dialog>

  <!-- How-to -->
  <section class="py-12 bg-amber-200">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-amber-700 mb-6">Getting a pattern to print true</h2>
      <ol class="space-y-4 text-stone-700 font-medium list-decimal list-inside">
        <li><strong class="text-stone-800">Open your PDF above.</strong> It is read straight off your disk &mdash; nothing is sent anywhere.</li>
        <li><strong class="text-stone-800">Turn off the sizes you do not need.</strong> Layer names usually look like &ldquo;Size 12&rdquo; or &ldquo;A4 / Letter&rdquo;. Leave any layer holding the outlines, notches, or grainlines switched on.</li>
        <li><strong class="text-stone-800">Make a PDF of the test square first.</strong> One page, one measurement. Open it, print at 100% or Actual Size, and check the square with a ruler.</li>
        <li><strong class="text-stone-800">Then do the rest.</strong> Same paper, same settings, and the tiles will line up.</li>
      </ol>
      <p class="mt-6 text-sm text-stone-600 font-medium">
        Stuck on a pattern? <a href="mailto:info@nedworkshop.org" class="font-bold text-amber-700 hover:text-amber-800 underline decoration-amber-400 decoration-2 underline-offset-4 hover:decoration-amber-500 transition-colors duration-300">Drop us an email</a>.
      </p>
    </div>
  </section>

  <!-- Common questions -->
  <section class="py-14 bg-amber-100 border-t-2 border-amber-200">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-amber-700">Common questions</h2>
      <div class="mt-6 space-y-6">
        {faqs.map(({ q, a }) => (
          <div>
            <h3 class="text-lg font-extrabold text-stone-800">{q}</h3>
            <p class="mt-1 text-stone-700 font-medium">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related tools -->
  <section class="py-12 bg-amber-200">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl font-extrabold text-amber-700">Also free to use</h2>
      <a
        href="/pattern-cleaner"
        class="group block mt-4 bg-white/80 rounded-2xl border-2 border-amber-200 hover:border-amber-400 hover:shadow-lg transition-all duration-300 p-5"
      >
        <h3 class="text-xl font-extrabold text-amber-700 group-hover:text-amber-800 transition-colors">
          Clean up a scanned embroidery pattern
        </h3>
        <p class="mt-1 text-stone-700 font-medium">
          For patterns you scanned out of a book &mdash; drop the gray paper background and print the
          lines in light blue, black, or any color.
        </p>
      </a>
      <p class="mt-5">
        <a href="/tools" class="font-bold text-amber-700 hover:text-amber-800 underline decoration-amber-400 decoration-2 underline-offset-4 hover:decoration-amber-500 transition-colors duration-300">
          Browse the whole Tool Library &rarr;
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Tailwind's display utilities outrank the UA rule for the `hidden`
     attribute, which this page leans on to swap panels in and out. */
  [hidden] {
    display: none !important;
  }

  /* --- Sticky chrome ---
     Both offsets are measured at runtime (see updateStickyOffsets) rather than
     hardcoded, because the site header changes height across breakpoints, on
     font load, and with the iOS safe-area inset. Each element sticks inside its
     own container, so both release naturally at the end of the page list. */
  #pv-viewer {
    scroll-margin-top: var(--pv-header-h, 0px);
  }

  #pv-toolbar {
    top: var(--pv-header-h, 0px);
  }

  @media (min-width: 1024px) {
    #pv-layers-panel {
      position: sticky;
      top: var(--pv-sticky-top, 0px);
      /* Never taller than what is left of the screen; the layer list scrolls. */
      max-height: calc(100vh - var(--pv-sticky-top, 0px) - 1.5rem);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #pv-layers-body {
      display: flex;
      flex-direction: column;
      min-height: 0;
      flex: 1 1 auto;
    }
    #pv-layer-list {
      max-height: none;
      min-height: 0;
      flex: 1 1 auto;
    }
  }

  /* --- Screen --- */
  .pv-page {
    position: relative;
    margin: 0 auto 1rem;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12), 0 8px 24px rgb(0 0 0 / 0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .pv-page canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pv-page::after {
    content: attr(data-label);
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
    color: #78716c;
    background: rgb(255 255 255 / 0.85);
    border-top-right-radius: 6px;
    pointer-events: none;
  }
  .pv-page.is-pending::before {
    content: '';
