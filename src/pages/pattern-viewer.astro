  .pv-layer-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pv-layer-list ul ul {
    margin-left: 0.75rem;
    padding-left: 0.5rem;
    border-left: 2px solid #ffedce;
  }
  .pv-layer-group-name {
    margin: 0.5rem 0 0.25rem;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #a8a29e;
  }
  .pv-layer-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
