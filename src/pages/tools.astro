---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTools } from '../lib/tools';

const description = "Browse the Ned Workshop Tool Library - sewing machines and more available to rent or borrow.";

const tools = await getTools();

// Group by category
const toolsByCategory = tools.reduce<Record<string, typeof tools>>((acc, tool) => {
  if (!acc[tool.category]) acc[tool.category] = [];
  acc[tool.category].push(tool);
  return acc;
}, {});

// Browser-based tools, shown as a category of their own ahead of the physical ones
const onlineTools = [
  {
    title: 'PDF Pattern Layer Viewer',
    brand: 'The Ned Workshop',
    href: '/pattern-viewer/',
    emoji: '&#129525;',
    description:
      'Open a layered PDF sewing pattern, switch off the sizes you are not cutting, and print what is left at true 1:1 scale. Runs in your browser&mdash;no Adobe Acrobat, no upload.',
    cta: 'Open the viewer',
  },
  {
    title: 'Pattern Scan Cleaner',
    brand: 'The Ned Workshop',
    href: '/pattern-cleaner/',
    emoji: '&#129529;',
    description:
      'Turn a gray, shadowy scan of an embroidery or craft pattern into crisp lines on clean white &mdash; in black, water-erasable blue, or any color. Runs in your browser&mdash;no upload.',
    cta: 'Open the cleaner',
  },
  {
    title: 'NeoSCAD',
    brand: 'The Ned Workshop',
    href: 'https://neoscad.org/try/',
    external: true,
    image: '/images/tools/neoscad.png',
    imageAlt: 'The NeoSCAD logo, a twisted helical ring',
    description:
      'Design 3D-printable parts with code. We built NeoSCAD to run OpenSCAD models right in your browser&mdash;nothing to install, no upload&mdash;and export STL files ready for the 3D printer.',
    cta: 'Try it at neoscad.org',
  },
];
---

<BaseLayout title="Tool Library" description={description} breadcrumbs={[{ name: 'Tool Library', url: '/tools/' }]}>
  <!-- Page Header -->
  <section class="bg-amber-50 py-10">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-6xl font-extrabold text-amber-700">
        Tool Library
      </h1>
      <p class="mt-4 text-xl md:text-2xl text-stone-700 font-semibold">
        A little market of things to borrow.
      </p>
    </div>
  </section>

  <!-- Free online tools, laid out like the tool categories below -->
  <section class="py-16 bg-amber-100">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-8 text-amber-700">
        Free Online Tools
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {onlineTools.map((tool) => (
          <a
            href={tool.href}
            {...(tool.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="group bg-white/80 rounded-2xl overflow-hidden border border-amber-200 hover:border-amber-400 hover:shadow-lg transition-all duration-300 flex flex-col"
          >
            {tool.image ? (
              <div class="relative w-full aspect-[3/2] bg-amber-50">
                <img src={tool.image} alt={tool.imageAlt} class="absolute inset-0 w-full h-full object-contain p-6" loading="lazy" />
              </div>
            ) : (
              <div class="w-full aspect-[3/2] bg-amber-50 flex items-center justify-center" aria-hidden="true">
                <span class="text-7xl leading-none" set:html={tool.emoji} />
              </div>
            )}
            <div class="p-5 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="text-xl font-extrabold text-amber-700 group-hover:text-amber-800 transition-colors leading-tight">{tool.title}</h3>
                <span class="shrink-0 bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-full">Free</span>
              </div>
              <p class="text-sm font-bold text-stone-500 uppercase tracking-wide mb-3">{tool.brand}</p>
              <p class="text-stone-700 font-medium flex-1" set:html={tool.description} />
              <p class="mt-3 font-extrabold text-amber-600 group-hover:text-amber-700 transition-colors">
                {tool.cta} &rarr;
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {Object.entries(toolsByCategory).map(([category, items], idx) => (
    <section class:list={["py-16", idx % 2 === 0 ? "bg-amber-200" : "bg-amber-100"]}>
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-8 text-amber-700">
          {category}{items.length > 1 ? 's' : ''}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((tool) => (
            <article class="bg-white/80 rounded-2xl overflow-hidden border border-amber-200 hover:border-amber-400 hover:shadow-lg transition-all duration-300 flex flex-col">
              {tool.image && (
                <img
                  src={tool.image.replace(/^\/public/, '')}
                  alt={tool.title}
                  class="w-full aspect-[3/2] object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-start justify-between gap-2 mb-1">
                  <h3 class="text-xl font-extrabold text-amber-700 leading-tight">{tool.title}</h3>
                  {tool.cost && (
                    <span class="shrink-0 bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-full">{tool.cost}</span>
                  )}
                </div>
                <p class="text-sm font-bold text-stone-500 uppercase tracking-wide mb-3">{tool.brand}</p>
                <p class="text-stone-700 font-medium flex-1">{tool.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
