---
/**
 * Brand assets, in one place — the marks, the palette, the social pack and the
 * screen-printing artwork, with a download link for each.
 *
 * Unlisted on purpose: nothing links here, it is `noindex, nofollow`, and it is
 * filtered out of the sitemap in astro.config.mjs. It is the page to send a printer
 * or a volunteer making a flyer, not a page for the public.
 *
 * Everything below is read off disk at build time, so the sizes and dimensions are
 * whatever the generators last produced. Assets that are not present are skipped
 * rather than listed as broken links — the packs are generated by hand
 * (`npm run brand:social`, `npm run brand:print`) and a checkout may not have them.
 */
import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COLORS } from '../../scripts/lib/palette.mjs';

const PUBLIC = resolve(process.cwd(), 'public');

// Just enough of each format to read its dimensions — no image library needed for
// a number that is sitting in the first few bytes of the file.
const pngSize = (buf) => ({ w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) });

function jpegSize(buf) {
  let i = 2;
  while (i + 9 < buf.length) {
    if (buf[i] !== 0xff) { i++; continue; }
    const marker = buf[i + 1];
    if (marker >= 0xc0 && marker <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marker)) {
      return { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
    }
    i += 2 + buf.readUInt16BE(i + 2);
  }
  return null;
}

function svgSize(text) {
  const m = text.match(/viewBox="[\d.]+ [\d.]+ ([\d.]+) ([\d.]+)"/);
  return m ? { w: Math.round(Number(m[1])), h: Math.round(Number(m[2])) } : null;
}

function asset(rel, use) {
  const file = resolve(PUBLIC, rel);
  if (!existsSync(file)) return null;
  const buf = readFileSync(file);
  const ext = rel.slice(rel.lastIndexOf('.') + 1).toLowerCase();
  const dims =
    ext === 'png' ? pngSize(buf)
    : ext === 'jpg' || ext === 'jpeg' ? jpegSize(buf)
    : ext === 'svg' ? svgSize(buf.toString('utf8'))
    : null;
  return {
    href: '/' + rel,
    name: rel.slice(rel.lastIndexOf('/') + 1),
    kind: ext.toUpperCase(),
    dims,
    bytes: statSync(file).size,
    use,
  };
}

const present = (...items) => items.filter(Boolean);

const fileSize = (n) =>
  n < 1024 ? `${n} B` : n < 1048576 ? `${Math.round(n / 1024)} KB` : `${(n / 1048576).toFixed(1)} MB`;

const dimLabel = (a) => (a.dims ? `${a.dims.w}×${a.dims.h}` : '—');

// ---------------------------------------------------------------- the packs

const marks = present(
  asset('images/logo.svg', 'The wide lockup. The vector master for anything on a light background.'),
  asset('images/brand/wordmark-wide.svg', 'The same lockup at 2400px, from the social pack.'),
  asset('images/brand/logo-tile.svg', 'The square tile — the stacked lockup on the green field.'),
  asset('images/brand/print/lockup-wide-transparent-2400.png', 'The mark with nothing at all behind it, for laying over a photo.')
);

const siteIcons = present(
  asset('favicon.svg', 'Browser tab. The icon mark — the starburst and an N — because three words of Titan One turn to mush at 16px.'),
  asset('favicon-96.png', 'Google rasterizes the search-result favicon itself and asks for a square multiple of 48px.'),
  asset('apple-touch-icon.png', 'iOS home screen, and the icon in manifest.webmanifest.'),
  asset('images/meta-image.jpg', 'The default og:image — what unfurls when the site is pasted into a chat.')
);

const social = present(
  asset('images/brand/profile-circle-safe-1024.png', 'Instagram, Facebook and YouTube profile. All three mask to a circle, so the mark is sized to survive the crop.'),
  asset('images/brand/profile-square-1024.png', 'Profile art anywhere the image is not circle-cropped. Bigger mark; the corners would clip under a mask.'),
  asset('images/brand/facebook-cover-1640x624.png', 'Facebook page cover.'),
  asset('images/brand/youtube-banner-2560x1440.png', 'YouTube channel banner. The mark sits inside the 1546×423 area that shows on every device.'),
  asset('images/brand/wordmark-wide-on-green-2400.png', 'The lockup on its green plate, for dropping into a light layout.')
);

// ------------------------------------------------------- screen-printing pack

const RECIPES = [
  {
    id: 'one-color',
    title: 'One screen',
    blurb:
      'Every word cut out of its patch and the whole mark flooded with a single ink. Supplied as black art, so the shop can run it in anything. The only version that works on a cap, a sleeve or a pocket.',
  },
  {
    id: 'dark-garment',
    title: 'Three screens',
    blurb:
      'For a dark garment. The green field is dropped and the shirt becomes the background, so the three patches float free — lighter on ink than a printed field, and the shirt shows through the knocked-out letters.',
  },
  {
    id: 'light-garment',
    title: 'Four screens',
    blurb:
      'For a natural or cream garment. The green field is printed and the knocked-out words reveal it, so the mark reads exactly as it does on screen.',
  },
];

const sepDir = (base) => resolve(PUBLIC, `images/brand/print/separations/${base}`);

function inksFor(base) {
  const dir = sepDir(base);
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith('.svg'))
    .sort()
    .map((f) => f.replace(/^\d+-|\.svg$/g, ''));
}

const printPack = RECIPES.map((r) => ({
  ...r,
  shapes: present(
    ...['wide', 'stacked'].map((shape) => {
      const art = asset(`images/brand/print/lockup-${shape}-${r.id}.svg`);
      return art ? { shape, art, inks: inksFor(`lockup-${shape}-${r.id}`) } : null;
    })
  ),
})).filter((r) => r.shapes.length);

const badge = asset('images/brand/print/icon-one-color.svg', 'The one-ink badge, for caps and sleeves.');

const previewDir = resolve(PUBLIC, 'images/brand/print/previews');
const previews = existsSync(previewDir)
  ? readdirSync(previewDir).filter((f) => f.endsWith('.png')).sort()
  : [];

// --------------------------------------------------------------------- palette

const palette = [
  { name: 'Quilt green', hex: COLORS.quilt, use: 'The field behind the mark' },
  { name: 'Pink', hex: COLORS.pink, use: 'The starburst behind “the”' },
  { name: 'Coral', hex: COLORS.coral, use: 'The NED patch, and the Donate button' },
  { name: 'Cream', hex: COLORS.cream, use: 'The workshop panel, and the NED letters' },
  { name: 'Ink', hex: COLORS.ink, use: 'The word “the”' },
  { name: 'Deep green', hex: COLORS.green, use: 'The word “workshop”' },
  { name: 'Page', hex: COLORS.page, use: 'The site background' },
];

const anyPack = marks.length || social.length || printPack.length;
---

<BaseLayout
  title="Brand Assets"
  description="Internal reference: the marks, palette, social pack and screen-printing artwork for The Ned Workshop."
  noindex
>
  <section class="bg-amber-50 py-10">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-sm font-bold uppercase tracking-widest text-amber-700">Internal reference</p>
      <h1 class="mt-2 text-5xl md:text-6xl font-extrabold text-amber-700">Brand Assets</h1>
      <p class="mt-4 max-w-2xl text-xl text-stone-700 font-semibold">
        Every mark we have, and the file to hand someone who asks for “the logo”.
      </p>
      <p class="mt-3 max-w-2xl text-stone-600">
        This page is unlisted — nothing links to it and search engines are told to skip it — so it
        is safe to send to a printer or a volunteer without it turning up in results.
      </p>
    </div>
  </section>

  {marks.length > 0 && (
    <section class="py-10">
      <div class="max-w-5xl mx-auto px-6">
        <div class="rounded-2xl bg-[#23392c] p-8 md:p-12 flex justify-center">
          <img src="/images/logo.svg" alt="The Ned Workshop" width="1200" height="264" class="w-full max-w-2xl h-auto" />
        </div>

        <h2 class="mt-10 text-3xl font-extrabold text-amber-700">The mark</h2>
        <p class="mt-2 max-w-2xl text-stone-700">
          Three words in Titan One, each on its own patch. Use the vector wherever you can —
          the type is already converted to outlines, so nothing depends on the font being installed.
        </p>
        <ul class="mt-6 grid gap-3">
          {marks.map((a) => (
            <li class="rounded-xl border-2 border-amber-200 bg-white p-4 sm:flex sm:items-start sm:gap-5">
              <div class="min-w-0 flex-1">
                <a href={a.href} download class="font-extrabold text-amber-700 hover:underline break-all">{a.name}</a>
                <p class="mt-1 text-sm text-stone-600">{a.use}</p>
              </div>
              <p class="mt-2 sm:mt-0 shrink-0 text-sm text-stone-500 tabular-nums">
                {a.kind} · {dimLabel(a)} · {fileSize(a.bytes)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="py-10 bg-amber-50">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-amber-700">Colors</h2>
      <p class="mt-2 max-w-2xl text-stone-700">
        Taken straight from the generator, so these can never drift from the artwork.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {palette.map((c) => (
          <li class="flex items-center gap-4 rounded-xl border-2 border-amber-200 bg-white p-3">
            <span class="h-12 w-12 shrink-0 rounded-lg border border-stone-300" style={`background:${c.hex}`}></span>
            <span class="min-w-0">
              <span class="block font-extrabold text-stone-800">{c.name}</span>
              <span class="block text-sm text-stone-600">{c.use}</span>
            </span>
            <code class="ml-auto shrink-0 text-sm font-bold text-stone-500 tabular-nums">{c.hex}</code>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {social.length > 0 && (
    <section class="py-10">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-extrabold text-amber-700">Profiles and banners</h2>
        <p class="mt-2 max-w-2xl text-stone-700">
          Sized for where each one goes. Regenerate with
          <code class="font-bold text-stone-800">npm run brand:social</code>.
        </p>
        <ul class="mt-6 grid gap-3">
          {social.map((a) => (
            <li class="rounded-xl border-2 border-amber-200 bg-white p-4 flex items-start gap-4">
              <img src={a.href} alt="" width="64" height="64" loading="lazy"
                   class="h-16 w-16 shrink-0 rounded-lg object-contain bg-stone-100" />
              <div class="min-w-0 flex-1">
                <a href={a.href} download class="font-extrabold text-amber-700 hover:underline break-all">{a.name}</a>
                <p class="mt-1 text-sm text-stone-600">{a.use}</p>
              </div>
              <p class="shrink-0 text-sm text-stone-500 tabular-nums">{dimLabel(a)} · {fileSize(a.bytes)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {siteIcons.length > 0 && (
    <section class="py-10 bg-amber-50">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-extrabold text-amber-700">Site icons</h2>
        <p class="mt-2 max-w-2xl text-stone-700">
          These are wired into the site already — listed so you know what is there. Regenerate with
          <code class="font-bold text-stone-800">npm run brand:assets</code>.
        </p>
        <ul class="mt-6 grid gap-3">
          {siteIcons.map((a) => (
            <li class="rounded-xl border-2 border-amber-200 bg-white p-4 flex items-start gap-4">
              <img src={a.href} alt="" width="48" height="48" loading="lazy"
                   class="h-12 w-12 shrink-0 rounded-lg object-contain bg-stone-100" />
              <div class="min-w-0 flex-1">
                <a href={a.href} download class="font-extrabold text-amber-700 hover:underline break-all">{a.name}</a>
                <p class="mt-1 text-sm text-stone-600">{a.use}</p>
              </div>
              <p class="shrink-0 text-sm text-stone-500 tabular-nums">{dimLabel(a)} · {fileSize(a.bytes)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {printPack.length > 0 && (
    <section class="py-10">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-extrabold text-amber-700">Merch and screen printing</h2>
        <p class="mt-2 max-w-3xl text-stone-700">
          A press charges by the screen, so these are ordered by what they cost to set up. Every
          file is flat spot colour with the type outlined — no gradients, no halftones, nothing for
          the shop to redraw. Send the SVG, not a PNG.
        </p>

        <div class="mt-6 grid gap-4">
          {printPack.map((r) => (
            <div class="rounded-xl border-2 border-amber-200 bg-white p-5">
              <h3 class="text-xl font-extrabold text-stone-800">{r.title}</h3>
              <p class="mt-1 max-w-3xl text-sm text-stone-600">{r.blurb}</p>
              <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                {r.shapes.map((s) => (
                  <li class="rounded-lg bg-amber-50 p-3">
                    <a href={s.art.href} download class="font-extrabold text-amber-700 hover:underline break-all">
                      {s.art.name}
                    </a>
                    <p class="mt-1 text-sm text-stone-600">
                      {s.shape === 'wide' ? 'Wide' : 'Stacked'} ·{' '}
                      {s.inks.length
                        ? `${s.inks.length} ${s.inks.length === 1 ? 'screen' : 'screens'}: ${s.inks.join(', ')}`
                        : 'one screen, any ink'}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))}

          {badge && (
            <div class="rounded-xl border-2 border-amber-200 bg-white p-5 flex items-start gap-4">
              <img src={badge.href} alt="" width="56" height="56" loading="lazy"
                   class="h-14 w-14 shrink-0 rounded-lg bg-stone-100 object-contain p-1" />
              <div class="min-w-0">
                <a href={badge.href} download class="font-extrabold text-amber-700 hover:underline break-all">{badge.name}</a>
                <p class="mt-1 text-sm text-stone-600">{badge.use}</p>
              </div>
            </div>
          )}
        </div>

        {previews.length > 0 && (
          <>
            <h3 class="mt-8 text-xl font-extrabold text-stone-800">On a garment</h3>
            <p class="mt-1 text-sm text-stone-600">Proofs, not artwork — for choosing a shirt colour.</p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {previews.map((f) => (
                <li>
                  <a href={`/images/brand/print/previews/${f}`} class="block">
                    {/* The wide and stacked proofs are nothing like the same shape, so they get a
                        common box to sit in — otherwise the captions step down the grid. */}
                    <img src={`/images/brand/print/previews/${f}`} alt={f.replace(/\.png$/, '').replace(/-/g, ' ')}
                         loading="lazy"
                         class="w-full h-32 rounded-lg border-2 border-amber-200 bg-stone-100 object-contain" />
                  </a>
                  <p class="mt-1 text-xs text-stone-500">{f.replace(/\.png$/, '').replace(/-/g, ' ')}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <section class="py-10 bg-amber-50">
    <div class="max-w-5xl mx-auto px-6 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-extrabold text-amber-700">Typeface</h2>
        <p class="mt-2 text-stone-700">
          The mark is set in <strong>Titan One</strong>, under the SIL Open Font License. Every file
          here has the glyphs converted to outlines, so nothing depends on it being installed.
          Body copy on the site is <strong>Baloo 2</strong>.
        </p>
      </div>
      <div>
        <h2 class="text-3xl font-extrabold text-amber-700">Regenerating</h2>
        <p class="mt-2 text-stone-700">
          Every asset here is drawn from one definition of the mark in
          <code class="font-bold text-stone-800">scripts/lib/wordmark.mjs</code>. Change it there,
          then re-run whichever pack you need — never edit an export by hand.
        </p>
        <ul class="mt-3 grid gap-1 text-stone-700">
          <li><code class="font-bold text-stone-800">npm run brand:assets</code> — site icons</li>
          <li><code class="font-bold text-stone-800">npm run brand:social</code> — profiles and banners</li>
          <li><code class="font-bold text-stone-800">npm run brand:print</code> — screen-printing artwork</li>
        </ul>
      </div>
    </div>
  </section>

  {!anyPack && (
    <section class="py-10">
      <div class="max-w-5xl mx-auto px-6">
        <p class="rounded-xl border-2 border-amber-300 bg-amber-100 p-5 text-stone-700">
          No generated assets found in <code class="font-bold">public/images/brand/</code>. Run
          <code class="font-bold">npm run brand:social</code> and
          <code class="font-bold">npm run brand:print</code> to build them.
        </p>
      </div>
    </section>
  )}
</BaseLayout>
