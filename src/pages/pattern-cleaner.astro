---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Clean up a scanned embroidery or craft pattern in your browser: remove the paper background and shadows, then print the lines in black, water-erasable blue, or any color you choose. Nothing is uploaded.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Pattern Scan Cleaner',
  url: 'https://nedworkshop.org/pattern-cleaner',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (web browser)',
  browserRequirements: 'Requires JavaScript.',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'The Ned Workshop' },
};
---

<BaseLayout title="Pattern Scan Cleaner" description={description} jsonLd={jsonLd}>
  <!-- Page header -->
  <section class="bg-amber-50 py-10 border-b-2 border-amber-200">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold text-amber-700">
        Pattern Scan Cleaner
      </h1>
      <p class="mt-4 text-lg md:text-2xl text-stone-700 font-semibold">
        Drop the paper background. Keep the lines. Pick their color.
      </p>
      <p class="mt-3 text-sm md:text-base text-stone-600 font-medium max-w-2xl mx-auto">
        Turn a gray, shadowy scan or photo of a pattern into crisp lines on a clean white page
        &mdash; in black, water-erasable pen blue, or any color you like.
        <strong class="text-stone-700">Your file never leaves your device.</strong>
      </p>
    </div>
  </section>

  <!-- No-JS fallback -->
  <noscript>
    <div class="max-w-3xl mx-auto px-6 py-10">
      <p class="bg-white border-2 border-amber-300 rounded-2xl p-5 text-stone-700 font-semibold">
        This tool needs JavaScript to read and redraw your scan. Everything runs on your own
        computer &mdash; nothing is uploaded &mdash; but that does mean the page cannot work with
        scripting turned off.
      </p>
    </div>
  </noscript>

  <!-- Step 1: choose a file -->
  <section id="pc-intro" class="py-12 bg-amber-100">
    <div class="max-w-3xl mx-auto px-6">
      <label
        id="pc-dropzone"
        for="pc-file"
        class="block bg-white/80 border-4 border-dashed border-amber-300 rounded-3xl p-10 text-center cursor-pointer transition-colors hover:border-amber-500 hover:bg-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-amber-500" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <circle cx="9" cy="9" r="2"></circle>
          <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
        </svg>
        <p class="mt-4 text-2xl font-extrabold text-amber-700">Choose a scan or photo</p>
        <p class="mt-1 text-stone-600 font-semibold">PDF, PNG, or JPEG &mdash; or drag and drop it here</p>
        <input id="pc-file" type="file" accept="application/pdf,.pdf,image/png,image/jpeg,image/webp" class="sr-only" />
      </label>

      <p id="pc-intro-status" class="mt-4 text-center font-bold text-amber-700 min-h-[1.5rem]" role="status" aria-live="polite"></p>

      <div class="mt-10 grid sm:grid-cols-3 gap-5 text-center">
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#128274;</p>
          <p class="mt-2 font-extrabold text-amber-700">Stays on your device</p>
          <p class="mt-1 text-sm text-stone-600 font-medium">The file is read in your browser. There is no upload and no server.</p>
        </div>
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#129529;</p>
          <p class="mt-2 font-extrabold text-amber-700">Cleans up the scan</p>
          <p class="mt-1 text-sm text-stone-600 font-medium">Paper texture, gray tint, and page-edge shadows disappear; only the drawn lines stay.</p>
        </div>
        <div class="bg-white/70 rounded-2xl border border-amber-200 p-5">
          <p class="text-3xl" aria-hidden="true">&#127912;</p>
          <p class="mt-2 font-extrabold text-amber-700">Lines in your color</p>
          <p class="mt-1 text-sm text-stone-600 font-medium">Print in pale blue so transfer lines hide under your stitches, or any color you choose.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2: the editor -->
  <section id="pc-editor" class="bg-amber-100 pb-16" hidden>
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <!-- Controls -->
      <div class="sticky top-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 pt-4 pb-3 bg-amber-100">
        <div class="bg-white border-2 border-amber-200 rounded-2xl px-4 py-3 shadow-sm flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="min-w-0 flex-1 basis-40">
            <p id="pc-filename" class="font-extrabold text-amber-700 truncate"></p>
            <p id="pc-pagecount" class="text-sm text-stone-500 font-semibold"></p>
          </div>

          <!-- Line color -->
          <fieldset class="flex items-center gap-2">
            <legend class="sr-only">Line color</legend>
            <span class="text-sm font-extrabold text-stone-600">Lines</span>
            <button type="button" data-color="#1c1c1c" title="Black" aria-label="Black lines" class="pc-swatch w-8 h-8 rounded-full border-2 border-stone-300" style="background:#1c1c1c"></button>
            <button type="button" data-color="#9dc9ef" title="Water-erasable pen blue" aria-label="Light blue lines" class="pc-swatch w-8 h-8 rounded-full border-2 border-stone-300" style="background:#9dc9ef"></button>
            <button type="button" data-color="#e05c5c" title="Red" aria-label="Red lines" class="pc-swatch w-8 h-8 rounded-full border-2 border-stone-300" style="background:#e05c5c"></button>
            <label class="relative w-8 h-8 rounded-full border-2 border-stone-300 overflow-hidden cursor-pointer" title="Custom color" style="background:conic-gradient(red,yellow,lime,cyan,blue,magenta,red)">
              <span class="sr-only">Custom line color</span>
              <input id="pc-color-custom" type="color" value="#9dc9ef" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
            </label>
          </fieldset>

          <!-- Line pickup -->
          <label class="flex items-center gap-3">
            <span class="text-sm font-extrabold text-stone-600 whitespace-nowrap">Line pickup</span>
            <input id="pc-pickup" type="range" min="5" max="95" step="1" value="70" class="w-36 accent-amber-500" />
          </label>

          <button id="pc-close" type="button" class="text-sm font-extrabold text-stone-500 hover:text-amber-700 underline underline-offset-4 transition-colors">
            Start over
          </button>
        </div>
      </div>

      <p id="pc-status" class="mt-3 text-center font-bold text-amber-700 min-h-[1.5rem]" role="status" aria-live="polite"></p>

      <!-- Pages -->
      <div id="pc-pages" class="mt-2 space-y-8"></div>

      <!-- Downloads -->
      <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
        <button id="pc-download-pdf" type="button" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-extrabold uppercase tracking-wider text-sm px-6 py-3 rounded-full shadow-md transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="m7 10 5 5 5-5"></path>
            <path d="M12 15V3"></path>
          </svg>
          Download PDF
        </button>
        <label class="flex items-center gap-2 text-sm font-bold text-stone-600 cursor-pointer">
          <input id="pc-transparent" type="checkbox" class="w-4 h-4 accent-amber-500" />
          Transparent background on PNGs
        </label>
      </div>

      <p class="mt-6 text-center text-sm text-stone-600 font-medium max-w-xl mx-auto">
        Tip: slide <strong>line pickup</strong> right to catch faint pencil lines, left if specks
        of paper texture are sneaking through. The preview updates as you drag.
      </p>
    </div>
  </section>

  <!-- How it works / privacy -->
  <section class="py-14 bg-amber-50 border-t-2 border-amber-200">
    <div class="max-w-3xl mx-auto px-6 space-y-6">
      <h2 class="text-3xl font-extrabold text-amber-700">How it works</h2>
      <p class="text-stone-700 font-medium">
        Book and magazine patterns are usually printed on toned paper, and scans pick up shadows and
        texture that waste ink and muddy your transfer. This tool compares every pixel of your scan
        to the paper around it, keeps only the marks that are genuinely darker than their
        surroundings, and redraws them on pure white. Because the comparison is local, it removes
        uneven lighting and page-curl shadows that a simple brightness threshold cannot.
      </p>
      <p class="text-stone-700 font-medium">
        Printing the lines in <strong>pale blue</strong> is a favorite embroidery trick: trace or
        transfer as usual, and the lines are light enough to disappear under your stitching &mdash;
        no washing out required. Everything happens in your browser with the same privacy as the
        <a href="/pattern-viewer" class="font-extrabold text-amber-600 hover:text-amber-700 underline underline-offset-4">PDF Pattern Layer Viewer</a>:
        your scan is never uploaded anywhere.
      </p>
      <p class="text-stone-700 font-medium">
        Please use it with patterns you have the right to copy for personal use &mdash; your own
        drawings, patterns from books you own, or free patterns.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pc-swatch[aria-pressed='true'],
  .pc-swatch:focus-visible {
    outline: 3px solid #d97706; /* amber-600 */
    outline-offset: 2px;
  }
</style>

<script>
  import pdfWorkerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';

  const STANDARD_FONT_DATA_URL = '/pdfjs/standard_fonts/';

  // Rendering caps: 300 dpi for PDFs, and never more than ~12.5 megapixels or
  // 3500 px on a side, which stays inside mobile Safari's canvas limits.
  const TARGET_DPI = 300;
  const MAX_SIDE = 3500;
  const MAX_PIXELS = 12.5e6;

  // Soft-threshold ramp width (gray levels). Pixels within the ramp get partial
  // coverage so diagonal lines print smooth instead of stair-stepped.
  const RAMP = 24;

  /**
   * @typedef {{
   *   gray: Uint8Array,      // grayscale pixels
   *   bg: Uint8Array,        // local paper-brightness estimate per pixel
   *   w: number, h: number,  // pixel dimensions
   *   ptsW: number, ptsH: number, // page size in PDF points for export
   *   canvas: HTMLCanvasElement,
   * }} Page
   */

  const state = {
    /** @type {Page[]} */ pages: [],
    color: '#9dc9ef',
    pickup: 70,
    transparent: false,
    baseName: 'pattern',
  };

  /** @type {any} */ let pdfjs = null;
  async function loadPdfjs() {
    if (pdfjs) return pdfjs;
    const lib = await import('pdfjs-dist/legacy/build/pdf.mjs');
    lib.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
    pdfjs = lib;
    return lib;
  }

  const $ = (/** @type {string} */ id) => /** @type {HTMLElement} */ (document.getElementById(id));
  const intro = $('pc-intro');
  const editor = $('pc-editor');
  const introStatus = $('pc-intro-status');
  const status = $('pc-status');
  const pagesHost = $('pc-pages');
  const fileInput = /** @type {HTMLInputElement} */ ($('pc-file'));
  const dropzone = $('pc-dropzone');

  const setStatus = (/** @type {string} */ msg) => { status.textContent = msg; };
  const yieldToBrowser = () => new Promise((r) => setTimeout(r, 0));

  // ---------------------------------------------------------------------------
  // Image math
  // ---------------------------------------------------------------------------

  /** Extract 8-bit grayscale from a drawn canvas. */
  function toGray(/** @type {CanvasRenderingContext2D} */ ctx, /** @type {number} */ w, /** @type {number} */ h) {
    const rgba = ctx.getImageData(0, 0, w, h).data;
    const gray = new Uint8Array(w * h);
    for (let i = 0, j = 0; i < gray.length; i++, j += 4) {
      // Rec. 601 luma, integer math.
      gray[i] = (rgba[j] * 77 + rgba[j + 1] * 151 + rgba[j + 2] * 28) >> 8;
    }
    return gray;
  }

  /**
   * Local mean brightness via a separable box blur — our estimate of the paper
   * color at each pixel. Windows shrink at the edges rather than wrapping.
   */
  function localBackground(/** @type {Uint8Array} */ src, /** @type {number} */ w, /** @type {number} */ h) {
    const r = Math.max(16, Math.round(Math.min(w, h) / 60));
    const tmp = new Float32Array(w * h);
    const out = new Uint8Array(w * h);

    for (let y = 0; y < h; y++) {
      const row = y * w;
      let sum = 0;
      let count = Math.min(r + 1, w);
      for (let x = 0; x < count; x++) sum += src[row + x];
      for (let x = 0; x < w; x++) {
        tmp[row + x] = sum / count;
        const add = x + r + 1;
        const sub = x - r;
        if (add < w) { sum += src[row + add]; count++; }
        if (sub >= 0) { sum -= src[row + sub]; count--; }
      }
    }

    const colSum = new Float64Array(w);
    let count = Math.min(r + 1, h);
    for (let y = 0; y < count; y++) {
      const row = y * w;
      for (let x = 0; x < w; x++) colSum[x] += tmp[row + x];
    }
    for (let y = 0; y < h; y++) {
      const row = y * w;
      for (let x = 0; x < w; x++) out[row + x] = colSum[x] / count;
      const add = y + r + 1;
      const sub = y - r;
      if (add < h) {
        const addRow = add * w;
        for (let x = 0; x < w; x++) colSum[x] += tmp[addRow + x];
        count++;
      }
      if (sub >= 0) {
        const subRow = sub * w;
        for (let x = 0; x < w; x++) colSum[x] -= tmp[subRow + x];
        count--;
      }
    }
    return out;
  }

  function hexToRgb(/** @type {string} */ hex) {
    const n = parseInt(hex.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  /** Slider position (5–95, right = fainter lines kept) → gray-level offset. */
  const pickupToOffset = (/** @type {number} */ v) => Math.max(5, 105 - v);

  /**
   * Classify and colorize one page into RGBA. A pixel is "ink" when it is
   * `offset` levels darker than the local paper estimate, with a small soft
   * ramp for anti-aliasing.
   */
  function compose(/** @type {Page} */ page, /** @type {boolean} */ transparent) {
    const { gray, bg, w, h } = page;
    const [cr, cg, cb] = hexToRgb(state.color);
    const offset = pickupToOffset(state.pickup);
    const img = new ImageData(w, h);
    const px = img.data;
    for (let i = 0, j = 0; i < gray.length; i++, j += 4) {
      const d = bg[i] - offset - gray[i]; // >0 → darker than paper by more than offset
      let a = (d + RAMP / 2) / RAMP;
      a = a < 0 ? 0 : a > 1 ? 1 : a;
      if (transparent) {
        px[j] = cr; px[j + 1] = cg; px[j + 2] = cb; px[j + 3] = (a * 255) | 0;
      } else {
        px[j] = 255 + (cr - 255) * a;
        px[j + 1] = 255 + (cg - 255) * a;
        px[j + 2] = 255 + (cb - 255) * a;
        px[j + 3] = 255;
      }
    }
    return img;
  }

  function renderPage(/** @type {Page} */ page) {
    const ctx = /** @type {CanvasRenderingContext2D} */ (page.canvas.getContext('2d'));
    ctx.putImageData(compose(page, false), 0, 0);
  }

  function renderAll() {
    for (const page of state.pages) renderPage(page);
  }

  // ---------------------------------------------------------------------------
  // Loading
  // ---------------------------------------------------------------------------

  function fitScale(/** @type {number} */ w, /** @type {number} */ h, /** @type {number} */ want) {
    let s = want;
    s = Math.min(s, MAX_SIDE / Math.max(w, h));
    s = Math.min(s, Math.sqrt(MAX_PIXELS / (w * h)));
    return Math.min(s, want);
  }

  /** Build a Page from a canvas the source has been drawn onto. */
  async function addPage(/** @type {HTMLCanvasElement} */ src, /** @type {number} */ ptsW, /** @type {number} */ ptsH, /** @type {number} */ index, /** @type {number} */ total) {
    const w = src.width, h = src.height;
    setStatus(total > 1 ? `Cleaning page ${index + 1} of ${total}…` : 'Cleaning up the scan…');
    await yieldToBrowser();
    const ctx = /** @type {CanvasRenderingContext2D} */ (src.getContext('2d', { willReadFrequently: true }));
    const gray = toGray(ctx, w, h);
    const bg = localBackground(gray, w, h);

    const card = document.createElement('div');
    card.className = 'bg-white border-2 border-amber-200 rounded-2xl p-3 sm:p-4 shadow-sm';
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    canvas.className = 'w-full h-auto rounded-lg border border-stone-200';
    canvas.setAttribute('role', 'img');
    canvas.setAttribute('aria-label', `Cleaned page ${index + 1}`);
    const bar = document.createElement('div');
    bar.className = 'mt-3 flex items-center justify-between gap-3';
    const label = document.createElement('p');
    label.className = 'text-sm font-bold text-stone-500';
    label.textContent = total > 1 ? `Page ${index + 1} of ${total}` : '';
    const pngBtn = document.createElement('button');
    pngBtn.type = 'button';
    pngBtn.className = 'text-sm font-extrabold text-amber-600 hover:text-amber-700 underline underline-offset-4 transition-colors';
    pngBtn.textContent = 'Download PNG';
    bar.append(label, pngBtn);
    card.append(canvas, bar);
    pagesHost.append(card);

    /** @type {Page} */
    const page = { gray, bg, w, h, ptsW, ptsH, canvas };
    pngBtn.addEventListener('click', () => downloadPng(page, index));
    state.pages.push(page);
    renderPage(page);
    await yieldToBrowser();
  }

  async function openPdf(/** @type {File} */ file) {
    const lib = await loadPdfjs();
    const doc = await lib.getDocument({
      data: await file.arrayBuffer(),
      standardFontDataUrl: STANDARD_FONT_DATA_URL,
    }).promise;
    $('pc-pagecount').textContent = doc.numPages === 1 ? '1 page' : `${doc.numPages} pages`;
    for (let n = 1; n <= doc.numPages; n++) {
      const pdfPage = await doc.getPage(n);
      const base = pdfPage.getViewport({ scale: 1 });
      const scale = fitScale(base.width, base.height, TARGET_DPI / 72);
      const viewport = pdfPage.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(viewport.width);
      canvas.height = Math.round(viewport.height);
      const ctx = /** @type {CanvasRenderingContext2D} */ (canvas.getContext('2d', { willReadFrequently: true }));
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      await pdfPage.render({ canvasContext: ctx, viewport }).promise;
      await addPage(canvas, base.width, base.height, n - 1, doc.numPages);
      pdfPage.cleanup();
    }
    doc.destroy();
  }

  async function openImage(/** @type {File} */ file) {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, fitScale(bitmap.width, bitmap.height, 1));
    const w = Math.round(bitmap.width * scale);
    const h = Math.round(bitmap.height * scale);
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    const ctx = /** @type {CanvasRenderingContext2D} */ (canvas.getContext('2d', { willReadFrequently: true }));
    ctx.drawImage(bitmap, 0, 0, w, h);
    bitmap.close();
    $('pc-pagecount').textContent = '1 page';
    // No physical size in a bare image — assume it was scanned at 300 dpi.
    await addPage(canvas, (w * 72) / TARGET_DPI, (h * 72) / TARGET_DPI, 0, 1);
  }

  async function openFile(/** @type {File} */ file) {
    reset();
    state.baseName = file.name.replace(/\.[^.]+$/, '') || 'pattern';
    $('pc-filename').textContent = file.name;
    intro.hidden = true;
    editor.hidden = false;
    try {
      if (file.type === 'application/pdf' || /\.pdf$/i.test(file.name)) {
        await openPdf(file);
      } else {
        await openImage(file);
      }
      setStatus('');
    } catch (err) {
      console.error(err);
      closeEditor();
      introStatus.textContent =
        'Sorry — that file could not be read. Try a PDF, PNG, or JPEG scan.';
    }
  }

  function reset() {
    state.pages = [];
    pagesHost.replaceChildren();
    setStatus('');
    introStatus.textContent = '';
  }

  function closeEditor() {
    reset();
    editor.hidden = true;
    intro.hidden = false;
    fileInput.value = '';
  }

  // ---------------------------------------------------------------------------
  // Downloads
  // ---------------------------------------------------------------------------

  function saveBlob(/** @type {Blob} */ blob, /** @type {string} */ name) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 10_000);
  }

  function pageToPngBlob(/** @type {Page} */ page, /** @type {boolean} */ transparent) {
    const canvas = document.createElement('canvas');
    canvas.width = page.w; canvas.height = page.h;
    const ctx = /** @type {CanvasRenderingContext2D} */ (canvas.getContext('2d'));
    ctx.putImageData(compose(page, transparent), 0, 0);
    return new Promise((/** @type {(b: Blob) => void} */ resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('toBlob failed'))), 'image/png'),
    );
  }

  async function downloadPng(/** @type {Page} */ page, /** @type {number} */ index) {
    const suffix = state.pages.length > 1 ? ` - page ${index + 1}` : '';
    const blob = await pageToPngBlob(page, state.transparent);
    saveBlob(blob, `${state.baseName} - cleaned${suffix}.png`);
  }

  async function downloadPdf() {
    const btn = /** @type {HTMLButtonElement} */ ($('pc-download-pdf'));
    btn.disabled = true;
    try {
      setStatus('Building your PDF…');
      await yieldToBrowser();
      const { PDFDocument } = await import('pdf-lib');
      const doc = await PDFDocument.create();
      doc.setTitle(`${state.baseName} (cleaned)`);
      for (const page of state.pages) {
        const blob = await pageToPngBlob(page, false);
        const png = await doc.embedPng(await blob.arrayBuffer());
        const p = doc.addPage([page.ptsW, page.ptsH]);
        p.drawImage(png, { x: 0, y: 0, width: page.ptsW, height: page.ptsH });
        await yieldToBrowser();
      }
      const bytes = await doc.save();
      saveBlob(new Blob([bytes], { type: 'application/pdf' }), `${state.baseName} - cleaned.pdf`);
      setStatus('');
    } catch (err) {
      console.error(err);
      setStatus('Sorry — building the PDF failed. You can still download each page as a PNG.');
    } finally {
      btn.disabled = false;
    }
  }

  // ---------------------------------------------------------------------------
  // Wiring
  // ---------------------------------------------------------------------------

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) openFile(fileInput.files[0]);
  });
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-amber-500', 'bg-white');
  });
  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-amber-500', 'bg-white');
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-amber-500', 'bg-white');
    const file = e.dataTransfer?.files?.[0];
    if (file) openFile(file);
  });

  const swatches = /** @type {HTMLButtonElement[]} */ ([...document.querySelectorAll('.pc-swatch')]);
  function selectColor(/** @type {string} */ color, /** @type {HTMLElement | null} */ swatch) {
    state.color = color;
    for (const s of swatches) s.setAttribute('aria-pressed', String(s === swatch));
    renderAll();
  }
  for (const s of swatches) {
    s.addEventListener('click', () => selectColor(/** @type {string} */ (s.dataset.color), s));
  }
  const customColor = /** @type {HTMLInputElement} */ ($('pc-color-custom'));
  customColor.addEventListener('input', () => selectColor(customColor.value, null));
  selectColor('#9dc9ef', swatches[1] ?? null);

  const pickup = /** @type {HTMLInputElement} */ ($('pc-pickup'));
  /** @type {ReturnType<typeof setTimeout> | undefined} */ let pickupTimer;
  pickup.addEventListener('input', () => {
    state.pickup = Number(pickup.value);
    clearTimeout(pickupTimer);
    pickupTimer = setTimeout(renderAll, 60);
  });

  $('pc-transparent').addEventListener('change', (e) => {
    state.transparent = /** @type {HTMLInputElement} */ (e.target).checked;
  });
  $('pc-download-pdf').addEventListener('click', downloadPdf);
  $('pc-close').addEventListener('click', closeEditor);
</script>
